# Supabase — get from Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gmail SMTP — used to send booking confirmation + visa letter emails
# GMAIL_USER   = your Gmail address  (e.g. yourname@gmail.com)
# GMAIL_APP_PASSWORD = 16-char App Password from Google Account > Security > App Passwords
#   Requires 2-Step Verification to be ON on your Google account
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App URL — used in email "Track Your Booking" links
NEXT_PUBLIC_APP_URL=https://your-vercel-url.vercel.app
